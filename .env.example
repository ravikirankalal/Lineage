# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# The Firebase web config is public by design (it ships in the page); it is not a secret.
# Leave everything empty to run Lineage local-only (no sign-in, no sync).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Set to 1 to use local emulators (npx firebase emulators:start --only auth,firestore --project demo-lineage)
VITE_FIREBASE_EMULATORS=
